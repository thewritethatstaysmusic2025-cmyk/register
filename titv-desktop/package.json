{
  "name": "titv-engineering-scheduler-desktop",
  "version": "4.0.3",
  "private": true,
  "description": "TITV 工程部製播排班系統 Windows Desktop",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewritethatstaysmusic2025-cmyk/register.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "tw.org.titv.engineering.scheduler",
    "productName": "TITV 工程部製播排班系統",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "main.cjs",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "thewritethatstaysmusic2025-cmyk",
        "repo": "register",
        "channel": "latest",
        "publishAutoUpdate": true
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TITV 工程部製播排班系統",
      "artifactName": "TITV_Engineering_Scheduler_Setup_${version}_${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
