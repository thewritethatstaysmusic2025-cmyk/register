{
  "name": "titv-engineering-scheduler-desktop",
  "version": "4.0.2",
  "private": true,
  "description": "TITV 工程部製播排班系統 Desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "tw.org.titv.engineering.scheduler",
    "productName": "TITV 工程部製播排班系統",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "main.cjs",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "TITV_工程部製播排班系統_macOS_${version}_${arch}.${ext}"
    },
    "dmg": {
      "title": "TITV 工程部製播排班系統 ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 150,
          "y": 220,
          "type": "file"
        },
        {
          "x": 450,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
